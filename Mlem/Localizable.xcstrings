    "You are browsing %@ as a guest. If you'd like to vote or reply, you'll need to log in or sign up." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás navegando por %@ como invitado. Si quieres votar o responder, tendrás que iniciar sesión o registrarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous parcourez %@ en tant qu'invité. Si vous souhaitez voter ou répondre, vous devez vous connecter ou vous inscrire."
          }
        }
      }
    },
    "You are required to provide an email on this instance." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En esta instancia es obligatorio indicar un correo electrónico."
