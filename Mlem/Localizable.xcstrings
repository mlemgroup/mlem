        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez choisir de continuer malgré tout, mais certaines fonctionnalités pourraient ne pas fonctionner sur cette version."
          }
        }
      }
    },
    "You cannot change your vote." : {
