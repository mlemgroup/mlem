          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous devez fournir une adresse e-mail sur cette instance."
          }
        }
      }
    },
    "You can also turn off search history completely for this account." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También puedes desactivar por completo el historial de búsqueda de esta cuenta."
