          }
        }
      }
    },
    "This content is no longer available.\n\nIt may have been removed automatically. PieFed purges content 7 days after it is removed.\n\nOr, it may have been purged by an administrator." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este contenido ya no está disponible.\n\nPuede que se haya retirado automáticamente. PieFed borra definitivamente el contenido 7 días después de retirarlo.\n\nO puede que lo haya borrado definitivamente un administrador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce contenu n'est plus disponible.\n\nIl a peut-être été supprimé automatiquement. PieFed supprime définitivement le contenu 7 jours après sa suppression.\n\nOu bien, il a peut-être été supprimé définitivement par un administrateur."
          }
        }
      }
    },
