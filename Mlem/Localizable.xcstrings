        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez également désactiver complètement l’historique de recherche pour ce compte."
          }
        }
      }
    },
    "You can choose to continue anyway, but some features may not work on this version." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
